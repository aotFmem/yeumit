# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# LINE LIFF Configuration
# Format: 10-digit number followed by alphanumeric ID (e.g., 1234567890-AbCdEfGh)
NEXT_PUBLIC_LIFF_ID=your-liff-id-here

# LINE Messaging API (Recommended: Replaces discontinued LINE Notify)
# Obtain from LINE Developers Console -> Messaging API tab -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token-here

# (Optional) Target User ID or Group ID to receive borrow alerts.
# If omitted, notifications are sent directly to the borrower's personal LINE chat!
LINE_ADMIN_TARGET_ID=your-admin-user-id-or-group-id

# Legacy LINE Notify (Discontinued after March 31, 2025)
LINE_NOTIFY_TOKEN=your-line-notify-token-here
